# Credenciais de Dinahosting para scripts/subir.sh.
#
# Copia este ficheiro a .dinahosting.env (xa está en .gitignore: NUNCA se
# sobe a git) e cubre os valores reais. Collelos do panel de Dinahosting:
# Hosting > Xestionar > FTP/SSH.

# ftp | ftps | sftp
DINA_PROTOCOLO=ftp

DINA_HOST=
DINA_PORT=
DINA_USUARIO=
DINA_CONTRASINAL=

# Ruta no servidor onde vive a raíz do subdominio divulga.galiciasustentable.org
DINA_RUTA_REMOTA=/

# Pon a 1 só se lftp dá erro de certificado en ftps/sftp e confías na causa
# (por exemplo un certificado autoasinado do propio hosting).
DINA_SSL_NO_VERIFY=0
